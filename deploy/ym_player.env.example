# /etc/ym_player.env - systemd 서비스가 읽는 설정 (chmod 600 권장: 비밀번호가 들어 있음)

# 다른 PC/TV/폰에서 접속하려면 0.0.0.0 (이 서버 안에서만 쓰면 127.0.0.1)
MP_HOST=0.0.0.0
MP_PORT=8899

# 사용자가 아직 하나도 없을 때 이 계정으로 첫 관리자를 만든다 (이미 사용자가 있으면 무시).
# 비워 두면 처음 접속한 화면에서 관리자 계정을 만든다 - 0.0.0.0으로 열면 서버를 띄우자마자 직접 만들 것.
MP_USER=yume
MP_PASSWORD=change-me

# 설정 파일 위치를 저장소 밖으로 빼고 싶으면 (기본: <저장소>/ym_player/data)
#MP_DATA_DIR=/var/lib/ym_player

# 텔레그램 서버 변환(ffmpeg). 보통은 sudo apt install ffmpeg 만 하면 되고 아래는 바꿀 때만.
#MP_FFMPEG=/usr/local/bin/ffmpeg
#MP_FFPROBE=/usr/local/bin/ffprobe
# 동시에 돌릴 변환 수 (HEVC 변환은 CPU를 많이 쓴다)
#MP_MAX_TRANSCODES=3
